# Configuration for the Job Recommendation API.
#
# Loading order (pydantic-settings): environment variables are read FIRST,
# then this .env file. Environment variables ALWAYS WIN over .env values.
# To override a value, set the variable in your shell before starting the app.

# Required. Your OpenRouter API key. Never commit a real key.
# Replace with your own key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model used for analysis. Default: openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# Vision model used for OCR of scanned PDFs and photo resumes.
# Must support image inputs (e.g. openai/gpt-4o-mini). Default: openai/gpt-4o-mini
OCR_MODEL=openai/gpt-4o-mini

# LLM call timeout in seconds. Default: 60
LLM_TIMEOUT_SECONDS=60

# Max tokens for the LLM response. Default: 4096
LLM_MAX_TOKENS=4096

# Max accepted document size in bytes (10 MiB). Default: 10485760
MAX_UPLOAD_BYTES=10485760

# Log level: DEBUG, INFO, WARNING, ERROR. Default: INFO
LOG_LEVEL=INFO

# Model for the profile extraction stage (markdown -> structured facts).
# Default: openai/gpt-4o-mini
PROFILE_MODEL=openai/gpt-4o-mini

# Temperature for OCR vision calls. 0.0 = deterministic extraction.
# Default: 0.0
OCR_TEMPERATURE=0.0

# Temperature for the profile and recommendation calls.
# Default: 0.0
LLM_TEMPERATURE=0.0

# Fidelity checkpoint mode: "lenient" drops unsupported facts and logs them;
# "strict" fails the request. Default: lenient
PROFILE_FIDELITY=lenient

# Per-document OCR page/call budget. Documents needing more fail with
# 422 ocr_budget_exceeded. Default: 10
MAX_OCR_PAGES=10

# LRU cap for the in-process extraction cache. Default: 256
EXTRACTION_CACHE_MAX_ENTRIES=256

# Entry TTL (seconds) for the extraction cache. Default: 3600
EXTRACTION_CACHE_TTL_SECONDS=3600

# deployment mode: "development" includes the response `meta` block by
# default and serves /docs. Default: production
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Authentication (SH-001..003)
# ---------------------------------------------------------------------------

# Comma-separated valid API keys. Callers present them as
#   Authorization: Bearer <key>
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Default: empty (no keyed identities; anonymous tier only).
API_KEYS=

# Alternative to API_KEYS: a file with one key per line (# starts a comment).
# Keep it OUTSIDE the repo and chmod 600. Default: unset
# API_KEYS_FILE=/etc/job-recommendation-api/keys.txt

# When true, anonymous (keyless) requests are rejected with 401.
# Default: false
AUTH_REQUIRED=false

# When false, keyless requests are rejected with 401 (key-only API).
# Default: true
ANONYMOUS_ENABLED=true

# ---------------------------------------------------------------------------
# Rate limiting (SH-004..006)
# ---------------------------------------------------------------------------

# Master switch for the per-identity sliding-window limiter. Default: true
RATE_LIMIT_ENABLED=true

# Authenticated tier: requests per window and window length (seconds).
# Defaults: 60 requests / 60 s per key
RATE_LIMIT_AUTH_REQUESTS=60
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Anonymous tier: requests per window and window length (seconds), per
# client IP. Defaults: 5 requests / 3600 s (1 hour)
RATE_LIMIT_ANON_REQUESTS=5
RATE_LIMIT_ANON_WINDOW_SECONDS=3600

# LRU bound on limiter state (max tracked identities). Default: 10000
RATE_LIMIT_MAX_TRACKED_IDENTITIES=10000

# Max concurrent document conversions (anyio capacity limiter).
# Default: 4
CONVERT_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Document parsing bounds (SH-007..008)
# ---------------------------------------------------------------------------

# Structural caps, all checked before decode/OCR work scales with the input:
# max pages per PDF, max embedded images decoded per page (excess skipped),
# and max page edge length in inches. Defaults: 50 / 20 / 30
MAX_PDF_PAGES=50
MAX_IMAGES_PER_PAGE=20
MAX_PAGE_INCHES=30

# Pillow decompression-bomb ceiling (decoded pixels per image) and max
# width/height in pixels for uploaded images. Defaults: 50000000 / 10000
MAX_IMAGE_PIXELS=50000000
MAX_IMAGE_DIMENSION=10000

# Wall-clock deadline (seconds) for the conversion stage (limiter wait +
# conversion). Expiry -> 422 conversion_failed. Default: 30
CONVERT_DEADLINE_SECONDS=30

# ---------------------------------------------------------------------------
# HTTP surface (SH-010..013)
# ---------------------------------------------------------------------------

# Serve /docs and /openapi.json. Default: enabled only when
# ENVIRONMENT=development (set true/false to override, e.g. for staging).
# DOCS_ENABLED=

# Comma-separated CORS origin allowlist. Empty = no CORS middleware at all
# (pure server-to-server API). Configuring '*' fails startup.
# Methods: POST, GET, OPTIONS. Headers: Authorization, Content-Type,
# X-Request-ID. Credentials are never allowed.
CORS_ORIGINS=